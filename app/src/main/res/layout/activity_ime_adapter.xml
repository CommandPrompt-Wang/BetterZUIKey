<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ime_adapter_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 总开关 -->
            <LinearLayout
                android:id="@+id/row_ime_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ime_enabled"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 切换时提示 -->
            <LinearLayout
                android:id="@+id/row_ime_toast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ime_toast"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_toast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ═══ 系统输入法框架 ═══ -->
            <TextView
                style="@style/ImeSectionHeader"
                android:text="@string/ime_sec_framework" />

            <TextView
                style="@style/ImeNote"
                android:layout_marginTop="4dp"
                android:text="@string/ime_sec_framework_desc" />
            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_framework_longpress_hint" />

            <LinearLayout
                android:id="@+id/list_framework"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_add_framework"
                style="@style/ImeAddButton"
                android:text="@string/ime_add_app" />

            <!-- ═══ 重映射快捷键 ═══ -->
            <TextView
                style="@style/ImeSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/ime_sec_remap" />

            <LinearLayout
                android:id="@+id/list_remap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btn_add_remap"
                style="@style/ImeAddButton"
                android:text="@string/ime_add_app" />

            <!-- ═══ 说明 ═══ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_note_1" />
            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_note_2" />
            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_note_3" />
            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_note_4" />
            <TextView
                style="@style/ImeNote"
                android:text="@string/ime_note_5" />

            <!-- ═══ 当前已安装 ═══ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                style="@style/ImeSectionHeader"
                android:layout_marginTop="12dp"
                android:text="@string/ime_installed_modules" />

            <LinearLayout
                android:id="@+id/list_installed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 高级入口（导入 / 恢复内置 / 制作 / 强制更新） -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/tv_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ime_import_profile"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_restore_builtins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ime_restore_builtins"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_make_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/profile_maker_ime_label_short"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_force_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/ime_force_update"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
